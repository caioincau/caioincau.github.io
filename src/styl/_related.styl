// Related Posts Section
.related-posts
  center(rem(800px))
  padding spacing2xl spacingLg
  margin-top spacing2xl
  border-top 1px solid var(--border-color)

.related-title
  font-size 1.5rem
  font-weight 700
  color var(--text-primary)
  margin-bottom spacingXl
  text-align center

.related-grid
  display grid
  grid-template-columns repeat(auto-fit, minmax(240px, 1fr))
  gap spacingLg

.related-card
  background var(--bg-card)
  border 1px solid var(--border-color)
  border-radius radiusMd
  padding spacingLg
  transition all transitionBase
  &:hover
    transform translateY(-2px)
    box-shadow shadowMd
    border-color var(--gradient-start)
  a
    text-decoration none

.related-card-title
  font-size 1rem
  font-weight 600
  line-height 1.4
  color var(--text-primary)
  margin-bottom spacingSm
  transition color transitionFast
  &:hover
    color var(--gradient-start)

.related-card-date
  font-size 0.8125rem
  color var(--text-muted)

.related-card-tags
  display flex
  flex-wrap wrap
  gap spacingXs
  margin-top spacingSm
  span
    font-size 0.6875rem
    padding 2px 8px
    background var(--bg-secondary)
    color var(--text-muted)
    border-radius radiusFull
