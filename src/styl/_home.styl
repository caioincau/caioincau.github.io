// Legacy home styles (kept for tags page compatibility)
.post-item
    text-align left
    padding spacingXl 0
    border-bottom 1px solid var(--border-color)
    center(rem(1000px))
    +below(rem(1000px))
        padding-left spacingLg
        padding-right spacingLg
    .datetime
        col(1/6)
        text-align center
        text-decoration none
        +below(cut)
            stack()
        .day
            mainFont(800)
            color var(--gradient-start)
            font-size rem(60px)
            line-height 1.4
            +below(cut)
                stack()
                font-size rem(40px)
        .month-year
            color var(--text-secondary)
            font-size rem(16px)
    .content
        col(5/6)
        +below(cut)
            stack()
        a
            text-decoration none
        .date
            color var(--gradient-start)
        .post-title
            color var(--text-primary)
            font-size rem(28px)
            line-height 1.3
            margin-bottom spacingSm
            transition color transitionFast
            +below(cut)
                text-align center
                font-size rem(24px)
            &:hover
                color var(--gradient-start)
        .description
            color var(--text-secondary)
            mainFont(400)
            font-size rem(17px)
            line-height 1.7
            a
                color var(--gradient-start)
                text-decoration underline

// Home main area
.home
    background var(--bg-primary)
    min-height 50vh
    padding-bottom spacing2xl

// Tags display
.tags
    margin-top spacingMd
    a
        display inline-block
        font-size rem(13px)
        font-weight 500
        padding spacingXs spacingSm
        margin-right spacingXs
        margin-bottom spacingXs
        background var(--bg-secondary)
        color var(--text-secondary)
        border-radius radiusFull
        text-decoration none
        transition all transitionFast
        &:hover
            background var(--gradient-start)
            color white
