// Reading Progress Bar
.reading-progress
  position fixed
  top 0
  left 0
  width 0%
  height 3px
  background-image linear-gradient(90deg, var(--gradient-start), var(--gradient-end))
  z-index 9999
  transition width 50ms linear

.reading-progress-container
  position fixed
  top 0
  left 0
  width 100%
  height 3px
  background var(--border-color)
  z-index 9998
  opacity 0
  transition opacity transitionBase
  &.visible
    opacity 1
