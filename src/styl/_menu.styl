*, *:before, *:after
    -moz-box-sizing border-box
    -webkit-box-sizing border-box
    box-sizing border-box

body
    left 0
    right 0
    margin auto

a, aside, .overlay, body
    transition all transitionBase

a.slideButton, .dosearch
    position fixed
    display block
    width 44px
    height 44px
    top 15px
    z-index 31
    border-radius radiusMd
    +below(cut)
        display none

.slideButton
    left 15px
    
.dosearch
    right 15px
    background var(--header-bg)
    backdrop-filter blur(12px)
    -webkit-backdrop-filter blur(12px)
    border 1px solid var(--border-color)
    padding spacingXs
    box-shadow shadowSm

.icon-menu
    cursor pointer
    padding spacingXs
    border-radius radiusMd
    background var(--header-bg)
    backdrop-filter blur(12px)
    -webkit-backdrop-filter blur(12px)
    border 1px solid var(--border-color)
    width rem(44px)
    height rem(44px)
    fill var(--text-primary)
    box-shadow shadowSm
    transition all transitionFast
    &:hover
        background var(--gradient-start)
        fill white
        border-color var(--gradient-start)

.icon-search
    width rem(36px)
    height rem(36px)
    fill var(--text-primary)
    transition fill transitionFast
    &:hover
        fill var(--gradient-start)

.overlay
    cursor pointer

#close
    display none

aside
    position fixed
    height 100%
    width rem(280px)
    padding spacingXl 0 0
    top 0
    left rem(-280px)
    background var(--bg-card)
    z-index 20
    box-shadow shadowXl
    border-right 1px solid var(--border-color)
    h2
        text-align center
        margin 0 0 spacingMd
        mainFont(700)
        font-size rem(14px)
        color var(--text-muted)
        text-transform uppercase
        letter-spacing 0.1em
    nav
        ul
            padding 0
        li
            margin 0
            list-style-type none
            a
                width 100%
                display block
                padding spacingMd spacingLg
                text-decoration none
                mainFont(500)
                color var(--text-secondary)
                border-left 3px solid transparent
                transition all transitionFast
                &:hover
                    color var(--gradient-start)
                    background var(--bg-secondary)
                    border-left-color var(--gradient-start)
        .feed
            border-top 1px solid var(--border-color)
            margin-top spacingSm
    &.slide
        left 0

a.slideButton.slide
    left rem(290px)
    pointer-events none

.overlay
    position fixed
    width 100%
    height 100%
    top 0
    left 0
    pointer-events none
    background transparent
    z-index 19
    &.slide
        pointer-events auto
        background rgba(0, 0, 0, 0.5)
        backdrop-filter blur(4px)
        -webkit-backdrop-filter blur(4px)
