.author
    background var(--bg-secondary)
    display table
    width 100%
    padding spacingXl 0
    margin spacingXl 0
    +above(cut)
        padding spacing2xl 0
    .details
        margin auto
        max-width rem(800px)
        padding 0 spacingLg
        +below(cut)
            text-align center
    img
        border-radius radiusFull
        display block
        margin auto
        border 4px solid var(--gradient-start)
        box-shadow shadowMd
        +above(cut)
            float left
            margin-right spacingXl
    .def
        color var(--text-muted)
        font-size rem(14px)
        mainFont(400)
        margin spacingSm
        text-transform uppercase
        letter-spacing 0.05em
        +above(cut)
            margin 0
            padding-top spacingMd
    .name
        margin 0
        a
            mainFont(700)
            text-decoration none
            color var(--text-primary)
            font-size rem(28px)
            transition color transitionFast
            &:hover
                color var(--gradient-start)
            +above(cut)
                font-size rem(36px)
    .desc
        mainFont(400)
        margin spacingSm
        font-size rem(15px)
        color var(--text-secondary)
        line-height 1.6
        +above(cut)
            font-size rem(17px)
    .email
        text-decoration none
        color var(--gradient-start)
        font-weight 500
        transition color transitionFast
        &:hover
            color var(--gradient-end)
