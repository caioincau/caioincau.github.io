// Skeleton Loading States
@keyframes shimmer
  0%
    background-position -200% 0
  100%
    background-position 200% 0

.skeleton
  background-image linear-gradient(90deg, var(--bg-secondary) 25%, var(--border-color) 50%, var(--bg-secondary) 75%)
  background-size 200% 100%
  animation shimmer 1.5s infinite
  border-radius radiusSm

.skeleton-card
  background var(--bg-card)
  border-radius radiusLg
  border 1px solid var(--border-color)
  overflow hidden
  .skeleton-image
    width 100%
    height 180px
    @extends .skeleton
    border-radius 0
  .skeleton-content
    padding spacingLg
  .skeleton-title
    @extends .skeleton
    height 1.5rem
    width 80%
    margin-bottom spacingMd
  .skeleton-text
    @extends .skeleton
    height 1rem
    margin-bottom spacingSm
    &:last-child
      width 60%
  .skeleton-tags
    display flex
    gap spacingXs
    margin-top spacingMd
    span
      @extends .skeleton
      width 60px
      height 24px
      border-radius radiusFull

.skeleton-post
  center(rem(800px))
  padding spacingXl
  .skeleton-heading
    @extends .skeleton
    height 2.5rem
    width 70%
    margin-bottom spacingXl
  .skeleton-line
    @extends .skeleton
    height 1rem
    margin-bottom spacingSm
    &:nth-child(odd)
      width 100%
    &:nth-child(even)
      width 90%
